{
  "rewrites": [
    {
      "source": "/conheca",
      "destination": "/conheca.html"
    },
    {
      "source": "/guias",
      "destination": "/conheca.html"
    },
    {
      "source": "/reservar",
      "destination": "/reservar.html"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/site?slug=:slug"
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "site.html"
    }
  }
}